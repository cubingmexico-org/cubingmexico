{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "exports",
    "types"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "packages/icons": {
      "ignoreDependencies": ["react", "@types/react"]
    },
    "packages/ui": {
      "ignoreDependencies": ["@tailwindcss/postcss", "postcss-load-config"]
    }
  }
}
