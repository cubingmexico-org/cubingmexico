# Root Monorepo Environment Template

# Database Connection (Local PostgreSQL default)
DB_URL=postgresql://postgres:postgres@localhost:5432/cubing_mexico
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cubing_mexico

# Backend Cron Auth Secret
CRON_SECRET=local-dev-cron-secret-12345

# Application Environment Mode
FLASK_ENV=development
NODE_ENV=development

# Skip Nominatim geocoding during backend WCA import (local default)
SKIP_GEOCODING=true

# GCP Project ID (Optional for local development)
GCP_PROJECT_ID=cubing-mexico

# Next.js API Base URL (Points to Flask Backend)
NEXT_PUBLIC_API_URL=http://localhost:8080
