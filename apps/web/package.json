{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "e2e:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f e2e/seed.sql",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "db:seed": "pnpm --filter @workspace/db seed",
    "db:studio": "pnpm --filter @workspace/db studio"
  },
