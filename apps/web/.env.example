# Database (local Docker Compose Postgres default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cubing_mexico

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# WCA OAuth
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# UploadThing
UPLOADTHING_TOKEN=

# Superadmin panel (/admin) — comma-separated WCA IDs
SUPERADMIN_WCA_IDS=

# Flask backend proxy for /admin/ops
BACKEND_URL=http://localhost:8080
CRON_SECRET=local-dev-cron-secret-12345

# Annual summary (user dropdown only when true)
NEXT_PUBLIC_ANNUAL_SUMMARY_ENABLED=false
