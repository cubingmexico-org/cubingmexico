# Database (local Docker Compose Postgres default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cubing_mexico

# Better Auth (web = port 3000)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me
# Must match organizer. Leave AUTH_COOKIE_DOMAIN unset locally (host-only localhost).
# Prod: AUTH_COOKIE_DOMAIN=cubingmexico.net
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# WCA OAuth — same app as organizer; redirect URIs must include:
# http://localhost:3000/api/auth/callback/wca
# http://localhost:3001/api/auth/callback/wca
# https://www.cubingmexico.net/api/auth/callback/wca
# https://certificados.cubingmexico.net/api/auth/callback/wca
# Scopes: public, manage_competitions
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# UploadThing
UPLOADTHING_TOKEN=

# Superadmin panel (/admin) — comma-separated WCA IDs
SUPERADMIN_WCA_IDS=

# Flask backend proxy for /admin/ops
BACKEND_URL=http://localhost:8080
CRON_SECRET=local-dev-cron-secret-12345

# Organización app (user dropdown link). Local: http://localhost:3001
# NEXT_PUBLIC_ORGANIZER_URL=http://localhost:3001
