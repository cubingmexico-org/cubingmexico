# Database Connection String
# Local PostgreSQL default:
DB_URL=postgresql://postgres:postgres@localhost:5432/cubing_mexico

# Cron Auth Secret (for /update-database, /update-state-ranks, etc.)
CRON_SECRET=local-dev-cron-secret-12345

# Environment mode (development / production)
FLASK_ENV=development

# Skip Nominatim reverse-geocoding during /update-database (recommended locally).
# When true, Mexican competitions are imported with state_id = null.
SKIP_GEOCODING=true

# GCP Project ID (Optional for local development)
GCP_PROJECT_ID=cubing-mexico

# --- Social RESULTADOS posts (Facebook + Instagram) ---
# Kill switch — must be true to post after a results import detects new MX comps.
SOCIAL_POSTS_ENABLED=false

# Public HTTPS base URL of this backend (required for Instagram image_url).
# Example production: https://api.cubingmexico.net
PUBLIC_BASE_URL=

# Meta Graph API (Page token with pages_manage_posts, instagram_content_publish, etc.)
# Prefer env locally; in prod these can also come from Secret Manager:
#   meta-page-access-token, facebook-page-id, instagram-business-account-id
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
