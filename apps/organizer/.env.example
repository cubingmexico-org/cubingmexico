# Database (local Docker Compose Postgres — same as apps/web)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cubing_mexico

# Better Auth (organizer = port 3001)
# BETTER_AUTH_SECRET must match apps/web
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Cubing México web (user dropdown link). Local: http://localhost:3000
# NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Leave AUTH_COOKIE_DOMAIN unset locally. Prod: AUTH_COOKIE_DOMAIN=cubingmexico.net
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# WCA OAuth — same app as web; create at https://www.worldcubeassociation.org/oauth/applications
# Redirect URIs:
# http://localhost:3000/api/auth/callback/wca
# http://localhost:3001/api/auth/callback/wca
# https://www.cubingmexico.net/api/auth/callback/wca
# https://certificados.cubingmexico.net/api/auth/callback/wca
# Scopes: public, manage_competitions
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# Cubing México Flask backend (pnpm services:up → localhost:8080)
API_URL=http://localhost:8080
