# Database (local Docker Compose Postgres — same as apps/web)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cubing_mexico

# Better Auth (organizer defaults to Next.js port 3000)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WCA OAuth — create an app at https://www.worldcubeassociation.org/oauth/applications
# Redirect URI: http://localhost:3000/api/auth/callback/wca
# Scopes: public, manage_competitions
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# Cubing México Flask backend (pnpm services:up → localhost:8080)
API_URL=http://localhost:8080
