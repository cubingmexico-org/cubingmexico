FROM node:22-alpine

WORKDIR /migrator

# Install only runtime deps (avoid pnpm workspace: protocol from package.json)
RUN npm init -y \
  && npm install dotenv@16.4.7 drizzle-orm@0.44.7 postgres@3.4.7 tsx@4.20.6

COPY packages/db/src ./src
COPY packages/db/drizzle ./drizzle

CMD ["sh", "-c", "npx tsx src/migrate.ts && npx tsx src/seed.ts"]
