FROM node:24-alpine

WORKDIR /repo

RUN corepack enable

# Versions come from pnpm-lock.yaml; only @workspace/db and its workspace deps are installed.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/db ./packages/db
RUN pnpm install --frozen-lockfile --filter @workspace/db...

CMD ["sh", "-c", "pnpm --filter @workspace/db migrate && pnpm --filter @workspace/db seed"]
