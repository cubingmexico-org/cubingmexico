{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "AUTH_COOKIE_DOMAIN",
    "AUTH_TRUSTED_ORIGINS",
    "BACKEND_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CRON_SECRET",
    "DATABASE_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_VERCEL_ENV",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SUPERADMIN_WCA_IDS",
    "UPLOADTHING_TOKEN",
    "WCA_CLIENT_ID",
    "WCA_CLIENT_SECRET"
  ],
  "globalPassThroughEnv": ["CI", "E2E_PORT", "NEXT_RUNTIME", "UV_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "check-types": {},
    "test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "env": ["TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
