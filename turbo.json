{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CRON_SECRET",
    "WCA_CLIENT_ID",
    "WCA_CLIENT_SECRET",
    "NODE_ENV",
    "DATABASE_URL",
    "UPLOADTHING_TOKEN",
    "API_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "AUTH_COOKIE_DOMAIN",
    "AUTH_TRUSTED_ORIGINS",
    "BACKEND_URL",
    "SUPERADMIN_WCA_IDS",
    "NEXT_PUBLIC_APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {},
    "check-types": {},
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "env": [
        "TEST_DATABASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}